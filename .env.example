# Copy this file to .env and change the values.
#   PowerShell:  Copy-Item .env.example .env
# .env is gitignored. Never commit real secrets.

APP_NAME="KaasuPay Loan Portal"
ENVIRONMENT=local

# SQLite file in the project folder (PostgreSQL comes in the stretch phase).
DATABASE_URL=sqlite:///./kaasupay.db

# Signs the login cookie (JWT). At least 32 characters. Make your own with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-of-32-plus-chars

# Encrypts Aadhaar numbers in the database. Make your own with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If you lose or change this key, Aadhaar numbers already saved can't be decrypted.
FERNET_KEY=paste-a-generated-fernet-key-here

# Login lasts 30 minutes.
ACCESS_TOKEN_MINUTES=30

# Keep false on http://localhost. Set true once we add HTTPS (stretch phase).
COOKIE_SECURE=false

# Password for the demo staff accounts made by `python -m app.seed`. Demo only.
SEED_STAFF_PASSWORD=Staff@Demo123
